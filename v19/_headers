/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://oracova.goatcounter.com; connect-src 'self' https://oracova.goatcounter.com; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'

# The order desk holds every customer's contact details. It is linked from nowhere,
# but a stray index would be worse than the robots.txt line that advertises the path.
/admin
  X-Robots-Tag: noindex, nofollow

# The production alias on pages.dev serves a full duplicate of the site; only
# oracova.com should be indexable. Preview deploys get this header from
# Cloudflare automatically, the production alias does not.
https://oracova-site.pages.dev/*
  X-Robots-Tag: noindex
